# Copiá este archivo a .env.local y completá los valores.
# .env.local NO se commitea: tiene secretos.

# ---------------------------------------------------------------------------
# CONVEX — base de datos y subscripciones en vivo
# ---------------------------------------------------------------------------
# En desarrollo, `npm run convex` levanta un backend local anónimo y completa
# estas dos variables solo. En producción salen de `npx convex deploy`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# PANEL DE COCINA
# ---------------------------------------------------------------------------
# Puerta del panel. No es auth real: es un PIN compartido por el equipo del
# local. Poné algo que no sea 1234 y cambialo si se va alguien del equipo.
PIN_PANEL=

# ---------------------------------------------------------------------------
# DOMINIO PÚBLICO
# ---------------------------------------------------------------------------
# Sin esto, la preview del link al compartirlo por WhatsApp o Instagram apunta
# a localhost y no carga la imagen. Es el link de la bio: tiene que estar bien.
# Ejemplo: https://inthestreet.com.ar
NEXT_PUBLIC_URL_BASE=
